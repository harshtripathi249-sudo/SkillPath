rules_version = '2';

// Paste into Firebase Console -> Firestore Database -> Rules -> Publish.
// Each signed-in user can only read/write their own document at users/{their-uid}.
// Nobody (including other signed-in users) can read or write anyone else's data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
