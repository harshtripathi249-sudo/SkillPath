# SkillPath Environment Configuration Example
# Copy this file to .env for local development

PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# When deploying the backend on its own (e.g. Render) with the frontend on a different
# domain (e.g. Vercel), set this to that frontend's URL to restrict CORS to it.
# Comma-separate multiple origins. Leave unset to allow all origins (fine for local dev).
# CORS_ORIGIN=https://your-frontend.vercel.app

# Optional external service credentials (placeholders only - do not commit real secrets)
# COURSERA_PARTNER_API_KEY=your_coursera_api_key_here
# EDX_ACCESS_TOKEN=your_edx_token_here

# Optional AI Learning Coach upgrade - set ONE of these to move the coach from
# rules-based answers to live LLM-generated answers grounded in the SkillPath catalog.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
