# SkillPath Frontend Environment Configuration Example
# Copy this file to .env for local development (never commit the real .env).
#
# These come from your Firebase project's Web App config
# (Firebase Console -> Project Settings -> General -> Your apps -> Web app).
# See the root README's "Firebase Setup" section for the full walkthrough.
#
# Run `npm run build` (or `npm run dev`, which runs it automatically) in this
# frontend/ folder to generate js/firebase-config.js from these values.
#
# On Vercel, set these same keys under Project Settings -> Environment Variables
# instead of committing a .env file - the build command already runs the generator.

FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
